# LINE Developers Console 取得
LINE_CHANNEL_ACCESS_TOKEN=你的_LINE_Channel_Access_Token
LINE_CHANNEL_SECRET=你的_LINE_Channel_Secret

# AI_PROVIDER 可用：auto / gemini / openai / rule
AI_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=你的_Gemini_API_Key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI optional，不用可留空
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5-mini

# Database
# 本機測試可以用 SQLite，不用設定 DATABASE_URL
DATABASE_PATH=stock_bot.db
# Render 正式部署建議用 PostgreSQL，把 Render Postgres Internal Database URL 設到 DATABASE_URL
DATABASE_URL=

# Scheduler
# 本機測試和 Render Web Service 建議 false
# 每日推播建議用 Render Cron Job：python -m scheduler.daily_job
ENABLE_SCHEDULER=false
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=30
TIMEZONE=Asia/Taipei

# Optional: 如果用外部服務打 /run-daily-report，就設定一個 secret
CRON_SECRET=

# RSS settings
MAX_NEWS_PER_STOCK=5
MAX_RSS_ITEMS_PER_SOURCE=30
